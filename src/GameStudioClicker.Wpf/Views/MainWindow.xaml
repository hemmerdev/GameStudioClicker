<Window x:Class="GameStudioClicker.Wpf.Views.MainWindow"
        xmlns:views="clr-namespace:GameStudioClicker.Wpf.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Game Studio Clicker"
        Icon="/Assets/Branding/AppIcon/app_icon_game_studio_clicker.png"
        Height="800"
        Width="1280"
        MinHeight="800"
        MinWidth="1280"

        Background="{StaticResource GameBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource BodyFontFamily}">


    <Window.Resources>
        <Style x:Key="WorkspaceTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabHeader"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2">
                            <ContentPresenter x:Name="TabLabel"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource SecondaryTextBrush}"
                                              TextElement.FontSize="14"
                                              TextElement.FontWeight="SemiBold"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeader" Property="Background"
                                        Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="TabLabel" Property="TextElement.Foreground"
                                        Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeader" Property="Background"
                                        Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="TabHeader" Property="BorderBrush"
                                        Value="{StaticResource PrimaryCyanBrush}" />
                                <Setter TargetName="TabLabel" Property="TextElement.Foreground"
                                        Value="{StaticResource PrimaryCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabHeader" Property="BorderBrush"
                                        Value="{StaticResource GlowBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,24,0,0"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header and notifications. -->
            <RowDefinition Height="Auto" />
            <!-- Main game interface. -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- Branding, status, and room for a future help control. -->
        <Grid x:Name="GameHeader"
              Grid.Row="0"
              Height="116"
              Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>

            <Image Source="/Assets/Branding/Logo/logo_game_studio_clicker.png"
                   Width="240"
                   Height="96"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   SnapsToDevicePixels="True" />

            <views:ActiveUpgradesView x:Name="HeaderUpgrades"
                                      Grid.Column="1"
                                      Margin="24,0,16,0"
                                      VerticalAlignment="Center" />

            <StackPanel Orientation="Vertical"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,6,0">

                <!-- Optional save confirmation overlay; currently kept hidden by ViewModel usage. -->
                <Border Grid.Row="0"
                        Panel.ZIndex="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="10,6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSaveConfirmation}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="Game Saved!"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" />
                </Border>

            </StackPanel>

            <!-- Music and offline earnings share a stable header slot. -->
            <Grid Grid.Column="2"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center">
                <Border x:Name="NowPlayingPanel"
                        Grid.Row="0"
                        Width="260"
                        Height="48"
                        Margin="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        HorizontalAlignment="Right">
                    <Border.RenderTransform>
                        <TranslateTransform X="16"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Hidden" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOfflineEarnings}"
                                             Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource VisualizerFadeInStoryboard}" />
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource VisualizerJumpStoryboard}" />
                        </EventTrigger>
                    </Border.Triggers>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Vertical"
                                    Grid.Column="0">

                            <TextBlock Text="NOW PLAYING "
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="8"
                                       Foreground="{StaticResource PrimaryCyanBrush}" />

                            <TextBlock Text="{Binding CurrentSoundtrackTitle}"
                                       FontSize="10"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Height="22"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">

                            <Border Width="4"
                                    Height="20"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource PrimaryCyanBrush}"
                                    CornerRadius="1"
                                    RenderTransformOrigin="0.5,1">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="VisualizerBar1Scale"
                                                    ScaleY="0.15"/>
                                </Border.RenderTransform>

                            </Border>

                            <Border Width="4"
                                    Height="20"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource PrimaryCyanBrush}"
                                    CornerRadius="1"
                                    RenderTransformOrigin="0.5,1">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="VisualizerBar2Scale"
                                                    ScaleY="0.25"/>
                                </Border.RenderTransform>

                            </Border>

                            <Border Width="4"
                                    Height="20"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource PrimaryCyanBrush}"
                                    CornerRadius="1"
                                    RenderTransformOrigin="0.5,1">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="VisualizerBar3Scale"
                                                    ScaleY="0.35"/>
                                </Border.RenderTransform>

                            </Border>

                            <Border Width="4"
                                    Height="20"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource PrimaryCyanBrush}"
                                    CornerRadius="1"
                                    RenderTransformOrigin="0.5,1">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="VisualizerBar4Scale"
                                                    ScaleY="0.45"/>
                                </Border.RenderTransform>

                            </Border>

                            <Border Width="4"
                                    Height="20"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource PrimaryCyanBrush}"
                                    CornerRadius="1"
                                    RenderTransformOrigin="0.5,1">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="VisualizerBar5Scale"
                                                    ScaleY="0.55"/>
                                </Border.RenderTransform>

                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Temporary message shown when offline progress is applied. -->
                <Border Grid.Row="0"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Padding="10,8"
                        Margin="0"
                        HorizontalAlignment="Right"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Opacity="0">

                    <Border.RenderTransform>
                        <TranslateTransform X="16" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Hidden" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOfflineEarnings}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource OfflineEarningsStoryboard}" />
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding OfflineEarningsMessage}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>
            </Grid>
        </Grid>


        <!-- Achievement notification overlay. -->
        <Border Grid.RowSpan="2"
                Panel.ZIndex="10"
                Width="360"
                Margin="0,0,8,8"
                Padding="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="2"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAchievementNotification}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible"/>

                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource AchievementNotificationStoryboard}"/>
                            </DataTrigger.EnterActions>

                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="44"
                       Height="44"
                       VerticalAlignment="Center"
                       Source="/Assets/Icons/Navigation/icon_achievements.png"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="ACHIEVEMENT UNLOCKED"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="9"
                               Foreground="{StaticResource WarningBrush}"/>

                    <TextBlock Text="{Binding AchievementNotificationName}"
                               Margin="0,7,0,3"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding AchievementNotificationDescription}"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- Persistent studio controls beside the shared workspace. -->
        <Grid x:Name="WorkspaceLayout" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="StudioSidebar" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <views:StudioView Grid.Row="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top" />

                <StackPanel Grid.Row="1" Margin="4,24,4,0">
                    <TextBlock Text="LINES OF CODE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
                        <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                               Width="30"
                               Height="30"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <TextBlock Text="{Binding LinesOfCode,
                                   Converter={StaticResource CompactNumberConverter}}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding LinesPerSecond,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="per second"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding LinesPerClick,
                                       Converter={StaticResource CompactNumberConverter}}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryCyanBrush}" />
                            <TextBlock Text="per click"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- The main action stays available on every workspace page. -->
                <Grid x:Name="ClickFeedbackLayer"
                      Grid.Row="3"
                      Height="100"
                      Margin="0,16,0,0"
                      ClipToBounds="False">
                    <Button x:Name="WriteCodeButton"
                            Height="64"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Command="{Binding WriteCodeCommand}"
                            PreviewMouseLeftButtonDown="WriteCodeButton_PreviewMouseLeftButtonDown"
                            Click="WriteCodeButton_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/Currency/icon_lines_of_code.png"
                                   Width="26"
                                   Height="26"
                                   Margin="0,0,10,0"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock Text="Write Code"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Column="1"
                    Width="1"
                    Margin="0,0,0,8"
                    Background="{StaticResource BorderBrush}"
                    IsHitTestVisible="False" />

            <TabControl x:Name="SharedWorkspace"
                        Grid.Column="2"
                        SelectedIndex="0"
                        Style="{StaticResource WorkspaceTabControlStyle}"
                        ItemContainerStyle="{StaticResource WorkspaceTabItemStyle}"
                        SelectionChanged="SharedWorkspace_SelectionChanged">
                <TabItem Header="Workers">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Your Team"
                                   Margin="0,0,0,18"
                                   Style="{StaticResource SectionHeadingTextStyle}" />
                        <views:WorkerUpgradesView Grid.Row="1" />
                    </Grid>
                </TabItem>

                <TabItem Header="Achievements">
                    <views:AchievementsView />
                </TabItem>

                <TabItem Header="Stats">
                    <views:StatisticsView />
                </TabItem>

                <TabItem Header="Settings">
                    <views:SettingsView />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
