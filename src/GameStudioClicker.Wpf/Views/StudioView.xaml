<UserControl x:Class="GameStudioClicker.Wpf.Views.StudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameStudioClicker.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Width="320"
                Padding="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel Orientation="Vertical">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentLocationName}"
                               Style="{StaticResource SectionHeadingTextStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StudioLevel, StringFormat='Level {0}'}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryCyanBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>

                <Grid Height="148"
                      Margin="0,12,0,12"
                      Background="{StaticResource GameBackgroundBrush}">
                    <Image Source="/Assets/Locations/studio_bedroom.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True" />
                </Grid>

                <ProgressBar Minimum="0"
                             Margin="0,8,0,6"
                             IsIndeterminate="False">

                    <ProgressBar.Style>
                        <Style TargetType="{x:Type ProgressBar}"
                               BasedOn="{StaticResource RoundedProgressBarStyle}">
                            <!-- Normal XP Progress -->
                            <Setter Property="Maximum"
                                    Value="{Binding ExperienceNeededForNextLevel}" />
                            <Setter Property="Value"
                                    Value="{Binding ExperienceIntoCurrentLevel, Mode=OneWay}" />

                            <Style.Triggers>
                                <!-- Full bar at max level -->
                                <DataTrigger Binding="{Binding IsStudioLevelMax}"
                                             Value="True">
                                    <Setter Property="Maximum"
                                            Value="1" />
                                    <Setter Property="Value"
                                            Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="{Binding StudioExperienceText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
